{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "build_pwa.py",
      "logo_original.jpeg",
      "HABI_SJDM_SOS_Installable_PWA_Package.zip"
    ],
    "rewrites": [
      { "source": "/", "destination": "/HABI_User_PWA/index.html" }
    ],
    "headers": [
      {
        "source": "**/service-worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/manifest.json",
        "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
      }
    ]
  }
}
